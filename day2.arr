use context starter2024
string-toupper("hello cs2000")
overlay(circle(30,'solid','blue'), rectangle(70, 60, 'solid', 'yellow'))
above(rectangle(60, 70, 'solid', 'green'), rectangle(80, 90, 'solid', 'purple'))
rotate(45, rectangle(100,20, 'solid', 'red'))
rotate(90, rectangle(100,20, 'solid', 'red'))
overlay-align('center','middle', text('STOP',80,'white'),regular-polygon(100, 8, 'solid', 'red'))